  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": "./dist/server",
    "rootDir": "./server",
    "skipLibCheck": true
  },
  "include": ["server/**/*.ts"],
  "exclude": ["server/__tests__/**"]
}
