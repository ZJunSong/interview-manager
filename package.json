{
  "name": "interview-manager",
  "version": "1.0.0",
  "description": "A lightweight job interview progress tracker with timeline visualization",
  "private": true,
  "license": "MIT",
  "keywords": [
    "interview",
    "job-search",
    "tracker",
    "vue3",
    "express",
    "typescript"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "pnpm --filter @interview-manager/web dev",
    "build": "pnpm --filter @interview-manager/web build",
    "start": "pnpm --filter @interview-manager/web start",
    "test": "vitest run packages/web/tests",
    "test:watch": "vitest packages/web/tests",
    "web:dev": "pnpm --filter @interview-manager/web dev",
    "web:build": "pnpm --filter @interview-manager/web build",
    "web:start": "pnpm --filter @interview-manager/web start"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0",
    "vitest": "^4.1.9",
    "vue": "^3.5.0"
  }
}
