# ============================================
# InterviewManager Web - 环境变量配置
# 复制此文件为 .env 并修改以下值
# ============================================

# 必须修改：JWT 密钥（用于用户认证）
# 生成方法: openssl rand -hex 32
JWT_SECRET=请替换为一个随机的64位十六进制字符串

# 服务端口（HTTP）
HTTP_PORT=80

# HTTPS 端口（启用 SSL 时使用）
# HTTPS_PORT=443

# 可选：绑定域名（用于 nginx server_name）
# SERVER_NAME=your-domain.com
