{
  "name": "@interview-manager/desktop",
  "version": "1.0.0",
  "description": "InterviewManager Desktop - Win installer version",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\" \"sleep 2 && electron .\"",
    "dev:server": "ts-node-dev --respawn --transpile-only server/index.ts",
    "dev:client": "vite",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:electron && npm run build:client && npm run build:server",
    "build:win": "npm run build && electron-builder --win",
    "start": "electron ."
  },
  "build": {
    "appId": "com.interview-manager.desktop",
    "productName": "Interview Manager",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "dist/**/*",
      "server/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Interview Manager"
    }
  },
  "dependencies": {
    "@interview-manager/shared": "workspace:*",
    "express": "^4.21.0",
    "cors": "^2.8.5",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "vite": "^6.1.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "vue": "^3.5.0",
    "typescript": "^5.7.0",
    "concurrently": "^9.0.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0"
  }
}
